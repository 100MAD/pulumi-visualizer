# Copy to .env in this directory. Django loads it when the API starts.
# Use KEY=value (not KEY: value).
SECRET_KEY=change-me
# Local/dev only. Production must leave this unset or set DEBUG=false.
DEBUG=true
# Optional. Containers set this to /tmp/db.sqlite3 (image /app is not writable).
# DATABASE_PATH=/tmp/db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser origin used after OIDC login (Vite dev server or production UI).
FRONTEND_URL=http://127.0.0.1:5173

# OIDC / SSO (optional). Leave OIDC_CLIENT_ID empty to use password login only.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Either discovery via issuer:
OIDC_ISSUER=
OIDC_DISCOVERY_URL=
# Or explicit Authentik-style endpoints:
OIDC_AUTH_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_SCOPES=openid profile email
OIDC_LABEL=Sign in with SSO
# Callback the browser hits (must match the IdP redirect URI). With Vite:
#   http://127.0.0.1:5173/api/auth/oidc/callback/
OIDC_REDIRECT_URI=http://127.0.0.1:5173/api/auth/oidc/callback/
# Comma-separated; user must be in at least one. Empty = any authenticated user.
OIDC_ALLOWED_GROUPS=
# Claim name that holds group names (Authentik default: groups).
OIDC_GROUPS_CLAIM=groups
# Set to false to require SSO when OIDC is configured.
OIDC_PASSWORD_LOGIN=true

# Preferred: discrete env (production AppDefinition + Vault for keys).
PULUMI_BACKEND_NAME=homelab
RUSTFS_BUCKET=pulumi-state
RUSTFS_PREFIX=
RUSTFS_ENDPOINT_URL=http://rustfs:9000
RUSTFS_REGION=us-east-1
RUSTFS_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional alternative: JSON list (local / multi-backend). When set, this wins
# over RUSTFS_*. Keep on one line. Credentials never returned to the browser.
# PULUMI_STATE_BACKENDS=[{"name":"homelab","bucket":"pulumi-state","prefix":"","endpoint_url":"https://s3.example","region":"us-east-1","access_key_id":"your-access-key","secret_access_key":"your-secret-key","addressing_style":"path"}]
